# NanoBanana（第三方调用路径：multimodal/crawl 出图）
# 办公网域名通常用：https://genai-sg-og.tiktok-row.org
NANOBANANA_3P_BASE_URL=https://genai-sg-og.tiktok-row.org
# 可选：备用域名（不填则不重试）
NANOBANANA_3P_FALLBACK_BASE_URL=
NANOBANANA_3P_AK=
NANOBANANA_3P_MODEL=gpt-image-1.5
# 可选：当模型为 gpt-image-1.5 时，质量参数（low/medium/high）
NANOBANANA_3P_OPENAI_IMAGE_QUALITY=low
# 可选：排版 JSON 使用的模型，不填则复用 NANOBANANA_3P_MODEL
NANOBANANA_3P_LAYOUT_MODEL=
# 可选：日志追踪
NANOBANANA_3P_LOGID=
