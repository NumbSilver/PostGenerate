# NanoBanana（第三方调用路径：multimodal/crawl 出图）
# 办公网域名通常用：https://genai-sg-og.tiktok-row.org
NANOBANANA_3P_BASE_URL=https://genai-sg-og.tiktok-row.org
# 可选：备用域名（不填则不重试）
NANOBANANA_3P_FALLBACK_BASE_URL=
NANOBANANA_3P_AK=
NANOBANANA_3P_MODEL=gpt-image-1.5
# 可选：当模型为 gpt-image-1.5 时，质量参数（low/medium/high）
NANOBANANA_3P_OPENAI_IMAGE_QUALITY=low
# 可选：OCR 模型（用于从海报A提取文字框，提升自动对齐）
NANOBANANA_3P_OCR_MODEL=openai_qwen-vl-ocr-latest
# 可选：OCR 专用域名（默认 https://search.bytedance.net）
NANOBANANA_3P_OCR_BASE_URL=
# 可选：OCR 备用域名
NANOBANANA_3P_OCR_FALLBACK_BASE_URL=
# 可选：OCR 独立 AK（不填则复用 NANOBANANA_3P_AK）
NANOBANANA_3P_OCR_AK=
# 可选：OCR 开关（1=开启，0=关闭）
NANOBANANA_3P_OCR_ENABLED=1
# 可选：OCR max_tokens
NANOBANANA_3P_OCR_MAX_TOKENS=1200
# 可选：OCR 遇到 429 后等待重试时间（毫秒）
NANOBANANA_3P_OCR_RATE_LIMIT_WAIT_MS=60000
# 可选：视觉理解模型（不填则复用 NANOBANANA_3P_OCR_MODEL）
NANOBANANA_3P_VISION_MODEL=
# 可选：样式分析开关（颜色/字号/字重/对齐）
NANOBANANA_3P_STYLE_HINT_ENABLED=1
# 可选：日志追踪
NANOBANANA_3P_LOGID=

# 结构理解 LLM（gpt-i18n）
GPT_I18N_BASE_URL=https://gpt-i18n.byteintl.net/gpt/openapi/online/v2/crawl
GPT_I18N_AK=

# 可选：当结构理解模型为 gpt-5.1-2025-11-13 时使用独立 AK（避免与其他调用共享额度）
GPT_5_1_AK=
